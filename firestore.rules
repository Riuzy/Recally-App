rules_version = '2';

// Recally security rules.
//
// The mobile app writes to Firestore directly, so these rules are the only
// thing standing between a user and other users' data. A user may only read
// and write documents under `users/{their own uid}`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything that is not explicitly allowed below.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isValidDeck() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'createdAt', 'updatedAt'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 120;
    }

    function isValidCard() {
      let data = request.resource.data;
      return data.keys().hasAll([
          'deckId', 'front', 'back', 'dueAt',
          'intervalDays', 'ease', 'reps', 'lapses',
          'createdAt', 'updatedAt'
        ])
        && data.front is string
        && data.back is string
        && data.front.size() <= 5000
        && data.back.size() <= 5000
        && data.intervalDays is int
        && data.intervalDays >= 0
        && data.ease is number
        && data.ease >= 1.3
        && data.ease <= 3.0;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /decks/{deckId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidDeck();

        match /cards/{cardId} {
          allow read, delete: if isOwner(uid);
          allow create, update: if isOwner(uid)
            && isValidCard()
            && request.resource.data.deckId == deckId;
        }
      }

      // Review history is append-only so stats stay trustworthy.
      match /reviews/{reviewId} {
        allow read, delete: if isOwner(uid);
        allow create: if isOwner(uid);
        allow update: if false;
      }
    }
  }
}
